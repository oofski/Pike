# PIKE Rush — Mac iMessage bridge configuration.
# Copy this file to ".env" (in this same folder) and fill in both values.
# You can find both of these on the app's Settings page (Texting / Bridge section).

# The API key the bridge uses to authenticate with the app.
RUSHMANAGER_API_KEY=

# The base URL of the running PIKE Rush app, e.g. http://192.168.1.42:5179
# (the app's Settings page shows the exact LAN URL to use).
RUSHMANAGER_API_URL=
